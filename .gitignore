# Home Assistant secrets — never commit
homeassistant/secrets.yaml
secrets.yaml
*.pem
*.key

# OS / editor
.DS_Store
.idea/
.vscode/

# Local HA runtime (Docker mounts ./homeassistant → /config)
homeassistant/.storage/
homeassistant/.cloud/
homeassistant/deps/
homeassistant/tts/
homeassistant/*.db
homeassistant/*.db-shm
homeassistant/*.db-wal
homeassistant/*.log
homeassistant/home-assistant.log*
homeassistant/.HA_VERSION
.env
.homeassistant/

# Portal CSV exports + generated reports (keep examples + dated day folders)
imports/*
!imports/.gitkeep
!imports/example-*.csv
!imports/*/
!imports/*/*.csv
!imports/absent-days.txt
output/*
!output/.gitkeep
!docs/index.html
