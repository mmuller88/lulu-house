# Copy to homeassistant/secrets.yaml (gitignored) on the HA host.
# HAN credentials: SmartVisio portal → HAN tab (not stored in this repo).

# Hoymiles HMS-800W-2T / DTU on home LAN
hoymiles_host: "192.168.x.x"

# PPC / Theben / EMH Smart Meter Gateway (HAN interface)
smgw_url: "https://192.168.100.100/cgi-bin/hanservice.cgi"
smgw_username: "HAN_USER_FROM_SMARTVISIO"
smgw_password: "HAN_PASSWORD_FROM_SMARTVISIO"

# Optional: secondary IP on HA host for SMGW subnet (see docs/network-smgw.md)
# smgw_ha_secondary_ip: "192.168.100.12"
